# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments
# The active gateway is auto-detected from the keys you set. When BOTH are
# configured, Flutterwave is used by default; override with PAYMENT_GATEWAY.
# Until FLW_SECRET_KEY is set, checkout keeps using Paystack automatically.

# Flutterwave (preferred when configured)
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# Must EXACTLY match the secret hash set in the Flutterwave dashboard
# (Settings → Webhooks); used to verify the verif-hash webhook header.
FLW_SECRET_HASH=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional explicit gateway override: "flutterwave" or "paystack".
PAYMENT_GATEWAY=flutterwave

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NAASIFY <info@naasify.online>
CONTACT_TO_EMAIL=info@naasify.online

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron — Vercel Cron calls /api/cron/expiring daily with
# "Authorization: Bearer <CRON_SECRET>". Set a long random string; the route
# refuses to run without it. Vercel sets this automatically for deployed crons.
CRON_SECRET=

# SEO / AEO
# Canonical public origin used for metadata, sitemap, robots, JSON-LD and OG images.
NEXT_PUBLIC_SITE_URL=https://naasify.online
# Optional Google Search Console token (adds <meta name="google-site-verification">).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional comma-separated social profile URLs (feeds Organization "sameAs").
NEXT_PUBLIC_SOCIAL_LINKS=

# Currency conversion fallback (NGN per 1 USD) used when the live FX API is unreachable
FX_FALLBACK_NGN_PER_USD=1500
FX_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json
